---
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mqpaqoob";

const trades: [string, string][] = [
  ["asphalt-paving", "Asphalt / paving contractor"],
  ["concrete", "Concrete contractor"],
  ["paver-interlock", "Paver / interlock installer"],
  ["electrician", "Electrician"],
  ["landscaper", "Landscaper"],
  ["builder-gc", "Builder / general contractor"],
  ["architect-designer", "Architect / design professional"],
  ["property-manager", "Property manager"],
  ["other", "Something else"],
];
---

<form
  class="tpf"
  data-tpf
  data-endpoint={FORMSPREE_ENDPOINT}
  novalidate
  action={FORMSPREE_ENDPOINT}
  method="post"
  aria-labelledby="tpf-title"
>
  <h2 class="tpf__title" id="tpf-title">Become a Trade Partner</h2>
  <p class="tpf__lead">Tell us a bit about your business. We&rsquo;ll follow up to talk through how a partnership could work.</p>

  <div class="tpf__fields">
    <div class="field">
      <label for="tpf-company">Company name</label>
      <input id="tpf-company" name="company" type="text" />
      <p class="dr__err" data-err="company" role="alert"></p>
    </div>
    <div class="field">
      <label for="tpf-trade">Trade / specialty</label>
      <select id="tpf-trade" name="trade" aria-describedby="err-trade">
        <option value="">Choose one</option>
        {trades.map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p class="dr__err" data-err="trade" id="err-trade" role="alert"></p>
    </div>
    <div class="field">
      <label for="tpf-name">Contact name</label>
      <input id="tpf-name" name="contactName" type="text" />
      <p class="dr__err" data-err="contactName" role="alert"></p>
    </div>
    <div class="field">
      <label for="tpf-phone">Phone</label>
      <input id="tpf-phone" name="phone" type="tel" />
      <p class="dr__err" data-err="phone" role="alert"></p>
    </div>
    <div class="field field--wide">
      <label for="tpf-email">Email</label>
      <input id="tpf-email" name="email" type="email" />
      <p class="dr__err" data-err="email" role="alert"></p>
    </div>
    <div class="field field--wide">
      <label for="tpf-notes">Tell us about your business (optional)</label>
      <textarea
        id="tpf-notes"
        name="notes"
        placeholder="What you do, where you work, and the kinds of projects you take on."
      ></textarea>
    </div>
  </div>

  <div class="tpf__hp" aria-hidden="true">
    <label>
      Leave this field empty
      <input type="text" name="_gotcha" autocomplete="off" tabindex={-1} />
    </label>
  </div>

  <div class="field">
    <label class="check">
      <input type="checkbox" name="consent" aria-describedby="err-consent" />
      <span>I agree that MeltGrid Canada may contact me about a partnership.</span>
    </label>
    <p class="dr__err" data-err="consent" id="err-consent" role="alert"></p>
  </div>

  <p class="dr__fail" data-tpf-fail hidden role="alert"></p>

  <button type="submit" class="btn btn--primary btn--lg">Send enquiry</button>

  <div class="tpf__done" data-tpf-done hidden tabindex={-1}>
    <h3>Thank you.</h3>
    <p data-tpf-done-text></p>
    <p>Questions in the meantime? Call <a href="tel:+14377745305">437-774-5305</a> or email <a href="mailto:info@meltgridcanada.ca">info@meltgridcanada.ca</a>.</p>
  </div>
</form>

<style>
  .tpf__title {
    font-size: var(--text-lg);
  }

  .tpf__lead {
    margin: 0.5rem 0 1.75rem;
    color: var(--fg-muted);
  }

  .tpf__fields {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-bottom: 1.25rem;
  }

  .tpf textarea {
    min-height: 6rem;
  }

  .tpf .btn {
    margin-top: 0.5rem;
  }

  .tpf__done {
    margin-top: 1.5rem;
    background: var(--ice);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .tpf__done p {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }
</style>

<script>
  import { trackEvent } from "../lib/analytics";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const form = document.querySelector<HTMLFormElement>("[data-tpf]");

  if (form) {
    const endpoint = form.dataset.endpoint || "";
    const failBox = form.querySelector<HTMLElement>("[data-tpf-fail]");
    const doneBox = form.querySelector<HTMLElement>("[data-tpf-done]");
    const doneText = form.querySelector<HTMLElement>("[data-tpf-done-text]");

    function setError(name: string, message: string) {
      const errorEl = form!.querySelector<HTMLElement>(`[data-err="${name}"]`);
      if (errorEl) errorEl.textContent = message;
      errorEl?.closest(".field")?.setAttribute("data-invalid", message ? "true" : "false");
    }

    function validate(): boolean {
      let valid = true;
      const fail = (name: string, message: string) => {
        setError(name, message);
        valid = false;
      };

      const company = form!.querySelector<HTMLInputElement>("#tpf-company")?.value.trim();
      const trade = form!.querySelector<HTMLSelectElement>("#tpf-trade")?.value;
      const contactName = form!.querySelector<HTMLInputElement>("#tpf-name")?.value.trim();
      const phone = form!.querySelector<HTMLInputElement>("#tpf-phone")?.value.trim();
      const email = form!.querySelector<HTMLInputElement>("#tpf-email")?.value.trim();
      const consent = form!.querySelector<HTMLInputElement>('input[name="consent"]')?.checked;

      if (!company) fail("company", "Enter your company name.");
      if (!trade) fail("trade", "Choose a trade.");
      if (!contactName) fail("contactName", "Enter a contact name.");
      if (!phone) fail("phone", "Enter a phone number.");
      if (!email || !EMAIL_RE.test(email)) fail("email", "Enter a valid email.");
      if (!consent) fail("consent", "Please agree so we can contact you.");

      return valid;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!validate()) return;

      trackEvent("trade_partner_form_submit");

      const honeypot = form.querySelector<HTMLInputElement>('input[name="_gotcha"]')?.value;
      if (honeypot) return;

      if (failBox) {
        failBox.hidden = true;
        failBox.textContent = "";
      }

      const body = new FormData(form);
      body.set("_subject", "New trade partner enquiry — MeltGrid Canada");
      body.set("_replyto", (form.querySelector<HTMLInputElement>("#tpf-email")?.value ?? ""));
      body.set("referring_page", window.location.pathname);
      body.set("submitted_at", new Date().toISOString());

      function showDone() {
        form!.querySelectorAll(".field, .tpf__hp, button[type=submit]").forEach((el) => {
          (el as HTMLElement).hidden = true;
        });
        if (doneText) {
          doneText.textContent =
            "We've received your details and will follow up to talk through how a partnership could work for the projects you take on.";
        }
        doneBox?.removeAttribute("hidden");
        doneBox?.focus();
      }

      if (!endpoint) {
        showDone();
        return;
      }

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body,
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`Request failed (${response.status})`);
        trackEvent("trade_partner_form_success");
        showDone();
      } catch {
        if (failBox) {
          failBox.hidden = false;
          failBox.textContent =
            "Something went wrong sending your enquiry. Please try again, or call 437-774-5305 / email info@meltgridcanada.ca.";
        }
      }
    });
  }
</script>
