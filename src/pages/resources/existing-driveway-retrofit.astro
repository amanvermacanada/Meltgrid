---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import CtaStrip from "../../components/CtaStrip.astro";

const title = "Snow Melting on an Existing Driveway? | MeltGrid Canada";
const description =
  "Retrofit methods for adding snow melting to an existing asphalt or concrete driveway, and why an existing paver driveway is a different case.";

const faqItems = [
  {
    q: "Can snow melting be added to an existing asphalt driveway?",
    a: ["Often. The installation manual describes cutting grooves into the finished asphalt, laying heating cable in them, and filling the grooves with sealer. Whether that suits your driveway depends on its condition, so an assessment confirms the options."],
  },
  {
    q: "Can snow melting be added to an existing concrete driveway?",
    a: ["Often, in one of two ways: a new layer of concrete poured over cable laid on the existing slab, or cable set into cut grooves in the finished concrete. An assessment of your slab confirms which applies."],
  },
  {
    q: "Can snow melting be added to an existing paver or interlock driveway?",
    a: ["The elements sit in the base beneath the pavers, so adding them generally means rebuilding that base. Whether that is practical for your project, and what it involves, is something an assessment of your paving would confirm."],
  },
  {
    q: "Is a retrofit as effective as installing during new construction?",
    a: ["A retrofit follows a different method than a new build, described in the manufacturer's installation manual for asphalt and concrete. Your design and an assessment of the existing surface confirm what applies to your project."],
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: "https://meltgridcanada.ca/resources/existing-driveway-retrofit/",
    isPartOf: { "@type": "WebSite", name: "MeltGrid Canada", url: "https://meltgridcanada.ca" },
    publisher: { "@type": "Organization", name: "MeltGrid Canada", url: "https://meltgridcanada.ca" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://meltgridcanada.ca/" },
      { "@type": "ListItem", position: 2, name: "Resources", item: "https://meltgridcanada.ca/resources/" },
      { "@type": "ListItem", position: 3, name: "Existing driveway retrofit" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/resources/existing-driveway-retrofit/" structuredData={structuredData}>
  <section class="phero phero--text">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources/" }, { label: "Existing driveway retrofit" }]} />
      <div class="phero__grid phero__grid--solo">
        <div class="phero__copy">
          <p>Resources</p>
          <h1>Can snow melting be added to an existing driveway?</h1>
          <p>
            It depends on the surface. Asphalt and concrete both have a manufacturer-documented retrofit method;
            an existing paver driveway is a different case.
          </p>
          <div class="phero__actions">
            <a class="btn btn--primary btn--lg" href="/contact/">Request my free design &amp; estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <p>The short answer</p>
      <div class="answer__body">
        <p>
          Often, for asphalt and concrete: the manufacturer's installation manual describes methods for cutting
          heating cable into an existing surface. There is no equivalent documented method for an existing paver
          driveway, where adding snow melting generally means rebuilding the base beneath the pavers. An
          assessment of your specific driveway confirms what applies.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Retrofit methods by surface</h2>
        <p>Each surface has its own documented approach, or lack of one.</p>
      </div>
      <div class="cmp">
        <article class="cmp__col">
          <p>Documented method</p>
          <h3>Existing asphalt</h3>
          <p>Grooves are cut into the finished asphalt, heating cable is laid in them, and the grooves are filled with sealer.</p>
          <ul>
            <li>Described in the manufacturer's installation manual</li>
            <li>Depends on the driveway's condition</li>
            <li>An assessment confirms whether it applies</li>
          </ul>
        </article>
        <article class="cmp__col">
          <p>Two documented methods</p>
          <h3>Existing concrete</h3>
          <p>Either a new layer of concrete is poured over cable laid on the existing slab, or cable is set into cut grooves in the finished concrete.</p>
          <ul>
            <li>Both described in the manufacturer's installation manual</li>
            <li>Depends on the slab's condition and thickness</li>
            <li>An assessment confirms which applies</li>
          </ul>
        </article>
      </div>
      <div class="er-pavers">
        <h3>Existing pavers or interlock</h3>
        <p>
          The heating elements sit in the base build-up beneath the pavers, not on top of an existing surface. The
          manufacturer's installation manual does not describe a method for adding snow melting under an existing
          paver driveway the way it does for asphalt and concrete. Adding it generally means rebuilding that base,
          and whether that is practical for your project is something an assessment of your specific paving would
          confirm.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ice">
    <div class="container">
      <div class="section-header">
        <h2>What an assessment looks at</h2>
        <p>The same considerations that shape any snow-melting design, applied to an existing surface.</p>
      </div>
      <ul class="reasons">
        <li><h3>Surface condition</h3><p>Cracking, settling or existing damage affects what a retrofit method can achieve.</p></li>
        <li><h3>Thickness and construction</h3><p>How the existing surface was built affects which method applies.</p></li>
        <li><h3>Electrical access</h3><p>Where power can reach the area, and what your panel can support.</p></li>
        <li><h3>Coverage goals</h3><p>Full coverage, tire tracks or targeted areas each have different implications for a retrofit.</p></li>
      </ul>
    </div>
  </section>

  <Faq heading="Retrofit questions" intro="Direct answers, surface by surface." items={faqItems} />

  <RelatedLinks
    heading="Keep reading"
    items={[
      { href: "/snow-melting/asphalt/", title: "Asphalt", body: "Installation under an asphalt driveway." },
      { href: "/snow-melting/concrete/", title: "Concrete", body: "Installation in concrete driveways." },
      { href: "/snow-melting/pavers/", title: "Pavers and interlock", body: "Installation beneath pavers." },
    ]}
  />

  <CtaStrip
    heading="Ask about your specific driveway"
    body="Send a photo or two and we'll tell you what's possible."
    primaryHref="/contact/"
    primaryLabel="Request my free design & estimate"
  />
</BaseLayout>
