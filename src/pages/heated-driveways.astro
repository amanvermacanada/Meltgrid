---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HowItWorks from "../components/HowItWorks.astro";
import StepList from "../components/StepList.astro";
import Faq from "../components/Faq.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import CtaStrip from "../components/CtaStrip.astro";

const title = "Heated Driveways in Canada | MeltGrid Canada";
const description =
  "How a heated driveway works, which surfaces and coverage options exist, and what to plan before you build or resurface. Request a free design and estimate.";

const faqItems = [
  {
    q: "Does a heated driveway run all winter?",
    a: [
      "No. With a sensor-based control the system switches on when conditions call for it, that is, when the sensor detects the temperature and moisture that mean snow or ice is forming, and switches off after the surface has cleared.",
      "Timer and manual controls are also available. Your design chooses the control approach that suits how you use the property.",
    ],
  },
  {
    q: "Can a heated driveway be added to an existing driveway?",
    a: [
      "Often, yes. The manufacturer's installation manual includes methods for existing surfaces: heating cable set into cut grooves in finished asphalt or concrete, or a new layer of concrete over heating cable on an existing slab.",
      "Which method suits your driveway depends on its condition and construction, so an assessment confirms the options.",
    ],
  },
  {
    q: "Which driveway surfaces can be heated?",
    a: ["Asphalt, concrete and pavers or interlock. Each is built differently, so the heating layout and installation method are designed for the surface you have or are about to build."],
  },
  {
    q: "Do I have to heat the whole driveway?",
    a: ["No. You can heat the whole surface, only the tire tracks, only the entrance and apron, or targeted areas such as steps and walkways. Your design compares the options for your driveway."],
  },
  {
    q: "Who installs a heated driveway?",
    a: ["Snow melting is installed as part of the surface work. A qualified electrician connects the system, and the paving, concrete or interlock contractor works to the design. MeltGrid coordinates the design and the trades through one project relationship."],
  },
  {
    q: "How much does a heated driveway cost?",
    a: ["It depends on the size of the area, how much of it you heat, the surface, the electrical work, the controls and the site conditions, so we do not publish fixed prices. A free design and estimate gives you a number for your property."],
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: "https://meltgridcanada.ca/heated-driveways/",
    isPartOf: { "@type": "WebSite", name: "MeltGrid Canada", url: "https://meltgridcanada.ca" },
    publisher: { "@type": "Organization", name: "MeltGrid Canada", url: "https://meltgridcanada.ca" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://meltgridcanada.ca/" },
      { "@type": "ListItem", position: 2, name: "Heated driveways" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Heated driveway snow melting systems",
    serviceType: "Snow and ice melting system design and installation coordination",
    description,
    url: "https://meltgridcanada.ca/heated-driveways/",
    provider: { "@type": "Organization", name: "MeltGrid Canada", url: "https://meltgridcanada.ca" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/heated-driveways/" structuredData={structuredData}>
  <section class="phero phero--split">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Heated driveways" }]} />
      <div class="phero__grid">
        <div class="phero__copy">
          <p>Heated driveways</p>
          <h1>Heated driveways for Canadian winters</h1>
          <p>
            A heated driveway uses electric heating in or beneath the surface to melt snow and ice, so you are not
            out there with a shovel. Here is how it works, what your options are and how a project comes together.
          </p>
          <div class="phero__actions">
            <a class="btn btn--primary btn--lg" href="/contact/?project=residential">Request my free design &amp; estimate</a>
            <a class="btn btn--outline btn--lg" href="/how-it-works/">See how it works</a>
          </div>
        </div>
        <figure class="phero__frame">
          <img
            src="/images/heated-driveway-winter-dusk.jpg"
            alt="Driveway in front of a two-car garage at dusk while snow falls, the pavement wet and clear with snow only along the edge"
            loading="eager"
            width="900"
            height="700"
          />
          <figcaption>Manufacturer imagery courtesy of WarmlyYours</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p>What is a heated driveway?</p>
      <div class="answer__body">
        <p>
          A heated driveway is a driveway with electric heating cable or mats installed in or beneath the surface.
          A sensor and controller switch the heat on when snow or ice conditions call for it, and the warmth melts
          snow and ice on the surface so it does not build up.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-header">
        <h2>How a heated driveway works</h2>
        <p>Snow, then a sensor, then a controller, then heat in the surface. Select a step to see what happens.</p>
      </div>
      <HowItWorks />
      <p style="margin-top:1.5rem;"><a href="/how-it-works/">The full explanation, with the components →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What is your driveway made of?</h2>
      <p>The heating is installed as part of the surface, so the method depends on whether you have asphalt, concrete or pavers.</p>
      <ul class="related-list" style="margin-top:1.5rem;">
        <li><a href="/snow-melting/asphalt/"><strong>Asphalt</strong> Elements set between a base coat and the finished asphalt. →</a></li>
        <li><a href="/snow-melting/concrete/"><strong>Concrete</strong> Elements tied near the top of the slab before the finish layer. →</a></li>
        <li><a href="/snow-melting/pavers/"><strong>Pavers and interlock</strong> Elements in the base build-up beneath the pavers. →</a></li>
      </ul>
    </div>
  </section>

  <section class="section section--ice">
    <div class="container">
      <div class="section-header">
        <h2>You do not have to heat everything</h2>
        <p>Heat the whole driveway, or only the parts you use most. Heating less area generally means less material to install and less power to run.</p>
      </div>
      <div class="cov">
        <div class="cov__plan" aria-hidden="true"></div>
        <div>
          <div class="dr__cards" role="radiogroup" aria-label="Coverage options">
            <label class="opt">
              <input type="radio" name="coverage-preview-hd" value="full" checked />
              <span class="opt__body">
                <span class="opt__label">Full coverage</span>
                <span class="opt__hint">Heat the whole driveway so the entire surface stays clear. The most complete result, with the most surface to heat. A good fit when you want no shoveling at all.</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="coverage-preview-hd" value="tracks" />
              <span class="opt__body">
                <span class="opt__label">Tire tracks</span>
                <span class="opt__hint">Heat two strips where the wheels travel. Snow can stay in the centre and along the edges while the wheel paths stay clear, with less area to heat than full coverage.</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="coverage-preview-hd" value="entrance" />
              <span class="opt__body">
                <span class="opt__label">Entrance and apron</span>
                <span class="opt__hint">Heat the area at the garage door and where the driveway meets the street, so you can get in and out without clearing those spots by hand.</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="coverage-preview-hd" value="targeted" />
              <span class="opt__body">
                <span class="opt__label">Targeted areas</span>
                <span class="opt__hint">Heat only the spots that matter most: steps, the front walkway, or a steep or shaded stretch. The smallest heated area, focused on safety and access.</span>
              </span>
            </label>
          </div>
          <div class="cov__help">
            <p class="fg-muted">The right option depends on your driveway, budget and how you use it. Your design compares them.</p>
            <a class="btn btn--outline btn--md" href="/contact/?project=residential&amp;intent=coverage-help">Help me choose</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>What to plan before you build or resurface</h2>
        <p>Snow melting goes in with the surface, so decisions made early save rework later.</p>
      </div>
      <StepList
        items={[
          { title: "The surface and how it is built", body: "A new driveway or a replacement is the simplest case. An existing driveway may be an option, depending on its condition and construction." },
          { title: "Electrical supply", body: "Available power, panel capacity and the distance from the panel to the driveway all shape the electrical work. A qualified electrician connects the system." },
          { title: "How much to heat", body: "Full coverage, tire tracks, the entrance and apron, or targeted areas. The right choice depends on how you use the driveway." },
          { title: "Controls and sensors", body: "Automatic sensor-based control, a timer, or a manual switch. The control approach affects how the system runs." },
          { title: "Timing with the construction", body: "Installation follows the paving, concrete or interlock schedule, so planning ahead helps." },
          { title: "Who coordinates", body: "The design, the electrician and the surface trades need to work to the same plan. That is the part MeltGrid coordinates." },
        ]}
      />
    </div>
  </section>

  <Faq
    dark
    heading="Heated driveway questions"
    intro="Direct answers first. For anything specific to your property, ask us and we will look at it in your design."
    items={faqItems}
  />

  <RelatedLinks
    heading="Keep reading"
    items={[
      { href: "/residential/", title: "Residential snow melting", body: "Driveways, walkways, steps and patios at home." },
      { href: "/cost/", title: "Cost and planning", body: "What shapes the cost of a heated driveway." },
      { href: "/technology/", title: "The technology", body: "Mats, cables, controls and sensors." },
    ]}
  />

  <CtaStrip
    heading="Ready to plan your driveway?"
    body="Tell us about your property. We come back with a design and an estimate."
    primaryHref="/contact/?project=residential"
    primaryLabel="Request my free design & estimate"
  />
</BaseLayout>

<style>
  .related-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .related-list a {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    color: var(--fg-muted);
  }
  .related-list strong {
    display: block;
    color: var(--fg);
    margin-bottom: 0.3rem;
  }
</style>
